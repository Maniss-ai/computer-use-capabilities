          "equals": {
            "kind": "input",
            "name": "member_id"
          }
        },
        {
          "target": {
            "kind": "field",
            "name": "Product",
            "scope": "workspace"
          },
          "equals": {
            "kind": "input",
            "name": "product"
          }
