          "sensitive": true,
          "true_when": null
        },
        "product": {
          "type": "string",
          "target": {
            "kind": "field",
            "name": "Product",
            "scope": "workspace"
          },
          "sensitive": false,
          "true_when": null
        },
        "nickname": {
          "type": "string",
          "target": {
            "kind": "field",
            "name": "Nickname",
            "scope": "workspace"
          },
          "sensitive": true,
          "true_when": null
        },
        "review_ready": {
          "type": "boolean",
          "target": {
            "kind": "field",
            "name": "Status",
            "scope": "workspace"
